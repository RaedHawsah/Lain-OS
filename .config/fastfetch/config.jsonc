{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "/home/rexkov/Pictures/wallpapers/fetch_image.png",
    "type": "kitty-direct",
    "width": 22,
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "magenta",
      "title": "magenta"
    }
  },

  "modules": [
    {
      "type": "custom",
      // النص عريض (Bold) باللون الوردي الغامق (RGB: 215, 95, 155) ومحاط بعلامات تنصيص
      "format": "\u001b[1;38;2;215;95;155m\"No matter where you go everyone is always connected\"\u001b[0m"
    },
    {
      "type": "separator",
      // خط فاصل مطاط بطول المقولة بالضبط (53 رمز) وبنفس اللون الوردي الغامق
      "string": "─────────────────────────────────────────────────────",
      "outputColor": "1;38;2;215;95;155"
    },
  
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "magenta"
    },
    {
      "type": "kernel",
      "key": "󰌽 Kernel",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "magenta"
    },
    {
      "type": "wm",
      "key": "󰨇 WM",
      "keyColor": "magenta"
    },
    {
      "type": "terminal",
      "key": "󰞌 Terminal",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "󰍛 CPU",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
